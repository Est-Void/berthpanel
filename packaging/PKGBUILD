# Maintainer: berthpanel <maintainer@example.invalid>
#
# BLOCKED — DO NOT UPLOAD (dev.md §12.5, stage 8.6).
#
# The license/distribution decision is not resolved: the repository is GPL-3.0,
# so every binary release must offer the Corresponding Source. Until that is
# settled (proposal: ship the source tarball in each release), this package is
# a draft. To finalize: set pkgver to the release tag, pin sha256sums from the
# release source tarball, drop the BLOCKED note, then `makepkg`.
#
# install.sh stays the primary path (dev.md §10); this is the distribution-
# native alternative.

pkgname=berthpanel
pkgver=0.0.0
pkgrel=1
pkgdesc="Local-first deploy panel for curated self-hosted apps (no root, allowlisted egress, net.log)"
arch=('x86_64' 'aarch64')
url="https://github.com/Est-Void/berthpanel"
license=('GPL-3.0-only')
# Runtime: git (clone), python >= 3.10 (SearXNG builds), systemd (user units).
# No root at runtime and no Docker daemon.
depends=('git' 'python' 'systemd')
makedepends=('gcc' 'make' 'zlib')
# The release build is already stripped with a deterministic build-id (dev.md §3).
options=('!strip')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('SKIP')  # TODO(8.6): pin the release source tarball's sha256

build() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  make release
}

package() {
  cd "${srcdir}/${pkgname}-${pkgver}"
  install -Dm755 build/release/berthpanel "${pkgdir}/usr/bin/berthpanel"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
